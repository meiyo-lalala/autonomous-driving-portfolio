<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lane_perception</name>
  <version>0.1.0</version>
  <description>车道线感知：调用 PyTorch U-Net 模型做语义分割并发布车道线点云（演示）</description>
  <maintainer email="liuhuiqi@example.com">Liu Huiqi</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>torch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
